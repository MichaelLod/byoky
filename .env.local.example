# Byoky live test keys
# Copy this file to .env.local (gitignored). Only the opt-in live runs read it:
#   pnpm test:live      (vitest.config.live.ts; also reads .env.test.local)
#   pnpm test:e2e       (Playwright against the real providers)
# `pnpm test` reads no keys and makes no paid calls.
# Each vitest live test skips when its key is missing. Release credentials go
# in .env; see .env.example.

# Translation live tests and the e2e run
# ANTHROPIC_API_KEY=sk-ant-api03-...   (an sk-ant-oat01- setup token also works)
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIza...
# COHERE_API_KEY=...

# Anthropic auth live tests (packages/core/tests/live/anthropic-oauth.live.test.ts)
# Setup token from `claude setup-token`; long-lived, scoped to inference.
# ANTHROPIC_SETUP_TOKEN=sk-ant-oat01-...
# API key with a BYOKY_TEST_ prefix so a global ANTHROPIC_API_KEY isn't used.
# BYOKY_TEST_ANTHROPIC_API_KEY=sk-ant-api03-...

# Byoky live test keys
# Copy this file to .env.local (gitignored). Only the opt-in live runs read it:
#   pnpm test:live      (vitest.config.live.ts; also reads .env.test.local)
#   pnpm test:e2e:live  (Playwright against the real providers)
# `pnpm test` and `pnpm test:e2e` read no keys and make no paid calls.
# Each vitest live test skips when its key is missing. Release credentials go
# in .env; see .env.example.

# Provider keys: the translation live tests and the live e2e run
# ANTHROPIC_API_KEY=sk-ant-api03-...
#   Keep an API key here: the e2e live flow and demo playground need one.
#   (The translation live tests would also take a setup token here, but
#   ANTHROPIC_SETUP_TOKEN below is its place.)
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIza...
# COHERE_API_KEY=...

# Claude setup token from `claude setup-token`; long-lived, scoped to
# inference. Its calls count against the Claude subscription behind it.
# Read by:
#   - the Anthropic auth live tests (packages/core/tests/live/anthropic-oauth.live.test.ts)
#   - the setup-token run of openai-to-anthropic.live.test.ts (needs
#     byoky-bridge on PATH)
#   - the OpenClaw e2e flow (e2e/tests/openclaw-flow.spec.ts), which fails
#     without it
# ANTHROPIC_SETUP_TOKEN=sk-ant-oat01-...

# Optional: an API key for the Anthropic auth live tests only. Without it
# they use ANTHROPIC_API_KEY when that holds an API key.
# BYOKY_TEST_ANTHROPIC_API_KEY=sk-ant-api03-...

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark only: the UI has no light theme. -->
    <style name="Theme.Byoky" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/brand_void</item>
        <item name="android:navigationBarColor">@color/brand_void</item>
        <item name="android:windowBackground">@color/brand_void</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- windowLightNavigationBar (API 27) is set in values-v27/themes.xml. -->
    </style>

    <style name="Theme.Byoky.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_void</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Byoky</item>
    </style>
</resources>

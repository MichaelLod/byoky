{
  "name": "@byoky/sdk",
  "description": "JavaScript SDK for Byoky, the MetaMask for API keys — connect your app to the user's wallet and make AI API calls without ever seeing their key",
  "version": "1.1.2",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "server": ["./dist/server.d.cts"]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MichaelLod/byoky.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://byoky.com",
  "keywords": ["byoky", "byok", "ai", "api-keys", "wallet", "metamask", "sdk", "llm", "openai", "anthropic", "gemini"],
  "dependencies": {
    "@byoky/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "25.5.0",
    "typescript": "^5.7.0"
  }
}
